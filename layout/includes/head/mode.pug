case theme.display_mode.type
    when "auto"
        script.
            initTheme = () => {
                let isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches
                const cachedMode = utils.saveToLocal.get('theme');
                if (cachedMode === undefined) {
                    const nowMode = isDarkMode ? 'dark' : 'light'
                    document.documentElement.setAttribute('data-theme', nowMode);
                    window.themeAuto = true;
                } else {
                    document.documentElement.setAttribute('data-theme', cachedMode);
                    window.themeAuto = false;
                }
                typeof rm === 'object' && rm.mode(cachedMode === 'dark' && isDarkMode)
            }
            initTheme()

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
                const systemMode = e.matches ? 'dark' : 'light';
                if (window.themeAuto) {
                    document.documentElement.setAttribute('data-theme', systemMode);
                    if (typeof window.handleThemeChange === 'function') {
                        window.handleThemeChange(systemMode);
                    }
                } else {
                    const cachedMode = utils.saveToLocal.get('theme');
                    if (cachedMode === systemMode) {
                        window.themeAuto = true;
                    }
                }
            });
    when "dark"
        script.
            initTheme = () => {
                const cachedMode = utils.saveToLocal.get('theme');
                if (cachedMode === undefined)
                    document.documentElement.setAttribute('data-theme', 'dark');
                else
                    document.documentElement.setAttribute('data-theme', cachedMode);
                typeof rm === 'object' && rm.mode(cachedMode === undefined || cachedMode === 'dark')
            }
            initTheme()
    when "light"
        script.
            initTheme = () => {
                const cachedMode = utils.saveToLocal.get('theme');
                if (cachedMode === undefined)
                    document.documentElement.setAttribute('data-theme', 'light');
                else
                    document.documentElement.setAttribute('data-theme', cachedMode);
                typeof rm === 'object' && rm.mode(cachedMode === 'dark')
            }
            initTheme()
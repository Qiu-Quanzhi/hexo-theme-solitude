link(rel="canonical" href=urlNoIndex())

if theme.extends.head
    each item in theme.extends.head
        != item

// Open Graph
include ../head/opengraph.pug

link(rel="stylesheet", href=url_for(theme.cdn.fontawesome))
link(rel="stylesheet", href=url_for(theme.cdn.fontawesome_solid))
link(rel="stylesheet", href=url_for(theme.cdn.fontawesome_brands))


// Feature-specific CSS
// swiper
if is_home() && theme.logs.home_mini && theme.logs.enable && site.data.logs.length > 1
    link(rel="stylesheet", href=url_for(theme.cdn.swiper_css) data-asset="swiper")

// katex
if theme.katex && theme.katex.enable && (theme.katex.per_page && (is_post() || is_page()) || page.katex)
    link(rel="stylesheet", href=url_for(theme.cdn.katex) data-asset="katex")

!=fragment_cache('injectHeadJs', function(){return inject_head_js()})

// theme
include ../head/mode

//- ===========================================
//- 主布局模板 - 重构后的清晰结构
//- ===========================================

include ./mixins/common.pug

- page.type = is_home() ? 'solitude' : page.type

doctype html
html(lang=config.language, data-theme="light")
    head
        include ./head.pug
    
    body#body(data-type=page.type)
        //- 全屏加载动画
        if theme.loading.fullpage
            +conditionalWrapper(theme.loading.fullpage)
                include ./loading.pug

        //- 控制台
        +conditionalWrapper(theme.console.enable)
            include ./console.pug

        //- 侧边栏
        include ./sidebar.pug

        //- 主体内容区域
        #body-wrap(class=is_post() ? 'post' : 'page')
            include ./header.pug

            if page.type !== '404'
                block content
                footer#footer
                    include ./footer.pug
            else
                .error#body-wrap
                    block content

        //- 页脚徽章（在 body-wrap 外，确保位于 100vh 以下）
        if theme.footer && theme.footer.badge
          #footer-badge
            each item in theme.footer.badge
              a.badge-link(href=url_for(item.url), target='_blank', rel='noopener nofollow', title=item.name)
                if item.icon
                  img.badge-icon(src=url_for(item.icon), alt=item.name)
                span= item.name

        //- 注入的body内容
        include ./inject/body.pug



//- ===========================================
//- 文章列表组件
//- ===========================================

include ../../mixins/common.pug

//- 文章信息组件
mixin postInfo()
  .recent-post-info-top
        span.article-meta.sticky-warp
            a.article-title(href=url_for(post.path), title=post.title)
                if is_home() && post.sticky
                    i.solitude.fas.fa-thumbtack.sticky.orange
                = post.title

        .article-content.article-container
            - let content = post.excerpt || strip_html(post.content)
            - let expert = content.substring(0, theme.index_post_list.length).replace(/\d+/g, '').replace(/&#xF/g, '').replace(/&#x/g, '')
            - content.length > theme.index_post_list.length ? expert += ' ...' : ''
            span.blog-slider__desc= expert
  
  //- 文章元数据
  +postMeta(post)

//- 文章封面组件  
mixin postCoverWrapper()
  if post.cover
    +postCover(post, {lazy: index >= 2})

//- 布局渲染
mixin layout()
    +postCoverWrapper()
    .recent-post-info
      +postInfo()

//- 主文章项组件
- var onclickAttr = "pjax.loadUrl('" + url_for(post.path) + "')"
.recent-post-item(onclick=onclickAttr)
    +layout()


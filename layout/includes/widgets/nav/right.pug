- var custom = theme.nav.right.custom || []
each item in custom
    .nav-button(id=item.id)
        a.site-page(href=url_for(item.url) || 'javascript:;', onclick=item.onclick, title=item.title || '')
            i.solitude(class=item.icon || '')
if theme.console.enable
    .nav-button#nav-console
        a.console_switchbutton(onclick="sco.showConsole()", title=_p('nav.console'))
            span.console-icon
                i.left
                i.center
                i.right

.nav-button#nav-totop(onclick="sco.toTop()")
    a.totopbtn
        i.solitude.fas.fa-arrow-up
        span#percent= "0"
#toggle-menu
    a.site-page
        i.solitude.fas.fa-bars
if hexo-config('brevity.enable')
  #home_top
    max-width 1400px
    width 100%
    margin 0 auto
    padding .5rem 1.5rem

    +maxWidth768()
      padding 0 1rem
      margin-top 0

@import "category-bar.styl"

if hexo-config('aside.position') == 0
  #home
    order 2
  #page
    order 2
else
  #home
    order 1
  #page
    order 1
